# Copy to .env and adjust. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
PLATFORM_NAME=TixGH
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (defaults to SQLite). Production example:
# DATABASE_URL=postgres://user:password@host:5432/tixgh

# SMS: console | arkesel | hubtel
SMS_BACKEND=console
SMS_SENDER_ID=TixGH
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# Email (console prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Background jobs (inline until Redis is set up)
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://localhost:6379/0

# Payments: simulated (development, no real money) | paystack
PAYMENT_GATEWAY=simulated
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BACKEND_URL=http://127.0.0.1:8000
ORDER_HOLD_MINUTES=10
